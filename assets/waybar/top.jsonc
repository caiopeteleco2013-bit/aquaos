// Barra de menu estilo macOS (menu bar): app em foco + botão ⌘ à esquerda,
// tray/volume/rede/bateria/hora à direita. Roda sobre o KWin — parte da
// shell própria do AquaOS (sem plasmashell).
{
    "layer": "top",
    "position": "top",
    "height": 28,

    "modules-left": ["wlr/window", "custom/menu"],
    "modules-right": ["tray", "pulseaudio", "network", "battery", "clock"],

    "wlr/window": {
        "format": "{}",
        "tooltip": false
    },
    "custom/menu": {
        "format": "⌘",
        "on-click": "wofi --show drun --prompt Buscar --style /etc/aquaos/wofi.css",
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "mudo",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip": false
    },
    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "cabo",
        "format-disconnected": "off",
        "tooltip": false
    },
    "battery": {
        "format": "{capacity}%",
        "states": {
            "warning": 25,
            "critical": 10
        },
        "tooltip": false
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{calendar}"
    }
}
