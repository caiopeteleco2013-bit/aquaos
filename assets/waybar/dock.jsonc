// Dock (base da tela) estilo macOS: os ícones das janelas abertas, em
// destaque. Implementado com o taskbar do Waybar sobre o protocolo
// foreign-toplevel (que o KWin também implementa) — no lugar do
// plasmashell, parte da shell própria do AquaOS.
{
    "layer": "top",
    "position": "bottom",
    "height": 66,

    "modules-center": ["wlr/taskbar"],

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-theme": "WhiteSur",
        "icon-size": 44,
        "spacing": 6,
        "tooltip": false,
        "on-click": "activate",
        "on-click-middle": "close"
    }
}
