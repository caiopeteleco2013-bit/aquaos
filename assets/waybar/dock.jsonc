{
    "position": "bottom",
    "height": 66,

    "modules-center": [
        "custom/terminal",
        "custom/finder",
        "custom/safari",
        "custom/captura",
        "custom/sair"
    ],

    // Dock estático da shell própria: KWin não implementa o protocolo
    // foreign-toplevel (lista de janelas) que barras wlroots usam, então
    // o dock fixo com launchers é o que funciona em 100% dos casos.
    "custom/terminal": {
        "format": "🖥",
        "on-click": "kitty",
        "tooltip": false
    },
    "custom/finder": {
        "format": "📁",
        "on-click": "nautilus",
        "tooltip": false
    },
    "custom/safari": {
        "format": "🌐",
        "on-click": "firefox",
        "tooltip": false
    },
    "custom/captura": {
        "format": "📷",
        "on-click": "spectacle -r",
        "tooltip": false
    },
    "custom/sair": {
        "format": "⏻",
        "on-click": "aquaos-sair",
        "tooltip": false
    }
}
